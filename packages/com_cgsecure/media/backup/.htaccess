#------------------------CG SECURE HTACCESS BEGIN-4.0.4---------------
# an idea from AESecure. CG Secure blocks and reports hacking attempts
#
#
ErrorDocument 403 "CG Secure : Access media cgsecure folder error"

# Be sure that pages under this folder won't be indexed
Options -Indexes
<IfModule mod_headers.c>
 Header set X-Robots-Tag "noindex, nofollow"
</IfModule>

<IfModule dir_module>
	DirectoryIndex disabled
	DirectoryIndex index.php
</IfModule>

# no access 
Order deny,allow
Deny from all

#------------------------CG SECURE HTACCESS END--------------------
