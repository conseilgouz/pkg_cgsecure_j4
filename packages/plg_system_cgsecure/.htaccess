#------------------------CG SECURE HTACCESS BEGIN-3.9.3---------------
# an idea from AESecure. CG Secure blocks and reports hacking attempts
#
#Deny access to all CGI, Perl, PHP and Python
<FilesMatch "\.(cgi|pl|py|php|jsp|sh|js)$">
Deny from all
</FilesMatch>

# secure directory by disabling script execution
AddHandler cgi-script  .pl .py .jsp .php .asp .sh .cgi .js
Options -ExecCGI

<Files htaccess.php>
    Order Allow,Deny
    Allow from all
</Files>

#------------------------CG SECURE HTACCESS END--------------------